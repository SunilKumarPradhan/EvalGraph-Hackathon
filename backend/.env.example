# ---- mode ----
EVALGRAPH_MOCK_LLM=1            # 1 = no DIAL calls; canned output; UI shows MOCK
EVALGRAPH_REPLAY=0              # 1 = serve recorded demo run (PHASE-08)
EVALGRAPH_DATA_DIR=../data
EVALGRAPH_MAX_CONCURRENCY=4

# ---- DIAL (Azure OpenAI-compatible proxy) ----
DIAL_API_KEY=
DIAL_ENDPOINT=https://ai-proxy.lab.epam.com
DIAL_API_VERSION=2024-02-01

# ---- deployments (list yours: cd ../../cuda-archer; uv run python -m cuda_archer.dial_check --list) ----
EVALGRAPH_MODEL=gpt-4.1-2025-04-14
EVALGRAPH_JUDGE_MODEL=claude-haiku-4-5@20251001
EVALGRAPH_SANDBOX_MODEL=gpt-4.1-mini-2025-04-14      # model the Docker sandbox gives analyzed apps
EVALGRAPH_SANDBOX_EMBED_MODEL=text-embedding-3-small-1

# ---- CUDA Archer (runs inside the runner process and reads these too) ----
ARCHER_MOCK_LLM=1               # keep equal to EVALGRAPH_MOCK_LLM
ARCHER_MODEL_LARGE=gpt-4o
ARCHER_MODEL_SMALL=gpt-4.1-mini-2025-04-14
